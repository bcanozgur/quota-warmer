    "%lld warm-ups × about 15K input and 100 output tokens at the catalog price of the model used. An estimate, not billing data; \"unpriced\" means the model is not in the price catalog yet.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld warm-ups × about 15K input and 100 output tokens at the catalog price of the model used. An estimate, not billing data; \"unpriced\" means the model is not in the price catalog yet."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ısıtma × yaklaşık 15 bin girdi ve 100 çıktı token’ı, kullanılan modelin katalog fiyatıyla. Bu bir tahmindir, fatura verisi değildir; \"fiyatsız\", modelin henüz fiyat kataloğunda olmadığı anlamına gelir."
          }
        }
      }
    },
