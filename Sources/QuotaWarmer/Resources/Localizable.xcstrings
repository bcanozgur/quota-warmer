        }
      }
    },
    " Each account is drawn in its own color, see-through where windows overlap.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Each account is drawn in its own color, see-through where windows overlap."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " Her hesap kendi renginde çizilir; pencereler üst üste geldiğinde yarı saydam görünür."
          }
        }
      }
    },
    " Orange is Claude and purple is Codex; a square used by both (neither above 80% of its tokens) is pink.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Orange is Claude and purple is Codex; a square used by both (neither above 80% of its tokens) is pink."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": " Turuncu Claude, mor Codex; ikisinin de kullandığı kare (hiçbiri token’ının %80’inden fazlasını kullanmadıysa) pembe olur."
          }
        }
      }
    },
