    "History": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş"
          }
        }
      }
    },
    "History is kept in ~/Library/Application Support/QuotaWarmer/events.jsonl and mirrored to ~/Library/Logs/QuotaWarmer/diagnostics.log. Tokens and authorization headers are redacted and are never written to history or warmup logs.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History is kept in ~/Library/Application Support/QuotaWarmer/events.jsonl and mirrored to ~/Library/Logs/QuotaWarmer/diagnostics.log. Tokens and authorization headers are redacted and are never written to history or warmup logs."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmiş ~/Library/Application Support/QuotaWarmer/events.jsonl dosyasında tutulur ve ~/Library/Logs/QuotaWarmer/diagnostics.log dosyasına yansıtılır. Token’lar ve yetkilendirme başlıkları gizlenir; geçmişe veya ısıtma günlüklerine hiçbir zaman yazılmaz."
          }
        }
      }
    },
    "Hit limit": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hit limit"
          }
        },
        "tr": {
          "stringUnit": {
