      }
    },
    "QuotaWarmer saves a reading on every quota check; charts fill in over the next few hours.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuotaWarmer saves a reading on every quota check; charts fill in over the next few hours."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QuotaWarmer her kota kontrolünde bir okuma kaydeder; grafikler önümüzdeki birkaç saat içinde dolar."
          }
        }
      }
    },
    "QuotaWarmer sent the warmup command for %@. The next quota refresh will confirm the active 5-hour window.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuotaWarmer sent the warmup command for %@. The next quota refresh will confirm the active 5-hour window."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QuotaWarmer %@ için ısıtma komutunu gönderdi. Bir sonraki kota yenilemesi etkin 5 saatlik pencereyi doğrulayacak."
          }
        }
      }
    },
    "QuotaWarmer uses capacity you already pay for, through the official CLI you're already signed into. It never bypasses or raises your limits, never shares or uploads your credentials, and sends nothing at all for tools left on Monitor or Off. Providers may change their APIs at any time; if automated warm-up is ever disallowed, set a tool to Monitor and QuotaWarmer keeps tracking your quota.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuotaWarmer uses capacity you already pay for, through the official CLI you're already signed into. It never bypasses or raises your limits, never shares or uploads your credentials, and sends nothing at all for tools left on Monitor or Off. Providers may change their APIs at any time; if automated warm-up is ever disallowed, set a tool to Monitor and QuotaWarmer keeps tracking your quota."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QuotaWarmer, zaten ödediğiniz kapasiteyi, zaten oturum açtığınız resmi CLI üzerinden kullanır. Limitlerinizi hiçbir zaman aşmaz veya yükseltmez, kimlik bilgilerinizi hiçbir zaman paylaşmaz veya yüklemez ve İzleme veya Kapalı’da bırakılan araçlar için hiçbir şey göndermez. Sağlayıcılar API’lerini istediği zaman değiştirebilir; otomatik ısıtmaya izin verilmediği takdirde bir aracı İzleme’ye alın; QuotaWarmer kotanızı izlemeye devam eder."
          }
        }
      }
    },
