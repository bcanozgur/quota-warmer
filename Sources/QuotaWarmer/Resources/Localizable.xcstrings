    "QuotaWarmer lives in your menu bar and watches your Claude Code and Codex 5-hour quota windows, so you always know how much is left and when it resets.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "QuotaWarmer lives in your menu bar and watches your Claude Code and Codex 5-hour quota windows, so you always know how much is left and when it resets."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "QuotaWarmer menü çubuğunda çalışır ve Claude Code ile Codex’in 5 saatlik kota pencerelerini izler; böylece ne kadarının kaldığını ve ne zaman sıfırlanacağını her zaman bilirsiniz."
          }
        }
      }
    },
    "QuotaWarmer only reads your quota here.": {
      "localizations": {
        "en": {
